# Where enquiries go. Every form on the site (customer, dealer, contact) and the
# enquiry chat post to /api/enquiry, which delivers each enquiry by email
# through Resend, to a webhook, or both. An enquiry counts as delivered when at
# least one of them accepts it.
#
# Nothing set: accepted and logged in development, 503 in production.

# --- Email, via Resend (https://resend.com) --------------------------------
# An API key with sending access.
RESEND_API_KEY=
# Who receives enquiries. Comma-separate several: sales@x.com,dealers@x.com
ENQUIRY_EMAIL_TO=
# Who they come from. Must be on a domain you have verified in Resend.
# Leave empty to use Resend's test sender (onboarding@resend.dev) — which can
# ONLY deliver to the email address of your own Resend account, so set
# ENQUIRY_EMAIL_TO to that address while testing.
ENQUIRY_EMAIL_FROM=

# --- Webhook ----------------------------------------------------------------
# Posts each enquiry as JSON: an inbox relay, a CRM intake URL, a Zapier or
# Make hook.
ZAP_ENQUIRY_WEBHOOK=
